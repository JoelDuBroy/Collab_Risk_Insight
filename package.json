{
  "name": "collab_risk_insight",
  "version": "1.0.0",
  "description": "GitHub collaboration insights + LLM narrative synthesis for Loop take-home",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.2.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^8.3.6"
  }
}
