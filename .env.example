# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# GitHub personal access token (classic or fine-grained).
# Required scopes / permissions:
#   classic: public_repo (or repo for private repos you own)
#   fine-grained: Contents read, Pull requests read, Issues read, Metadata read
GITHUB_TOKEN=

# Optional default repo used by the demo UI
GITHUB_OWNER=vercel
GITHUB_REPO=swr

# Lookback window for insights when not specified in the query
DEFAULT_LOOKBACK_DAYS=30

# SQLite path for caching GitHub payloads + computed insights
DATABASE_PATH=./data/collab_risk_insight.sqlite

# Cache TTL for stored GitHub snapshots (seconds)
CACHE_TTL_SECONDS=900

# LLM provider: anthropic | openai | mock
# Use "mock" to demo narrative shape without an API key.
LLM_PROVIDER=mock

# Anthropic (preferred — aligns with Tempo/Bedrock Claude stack)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI-compatible alternative
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
